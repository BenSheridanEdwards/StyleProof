{
  "description": "Oracle: exact computed-style values StyleProof MUST reproduce from index.html. Only properties that DIFFER from browser UA defaults are asserted (StyleProof prunes default-matching values). Forced pseudo-states (:hover/:focus/:active) are asserted in expectedStates. Pseudo-elements (::before/::after) are asserted in expectedPseudo.",
  "byTestId": {
    "hero": {
      "tag": "div",
      "cls": "hero-container",
      "expectedStyles": {
        "background-color": "rgb(248, 250, 252)",
        "padding-top": "32px",
        "padding-right": "32px",
        "padding-bottom": "32px",
        "padding-left": "32px",
        "box-sizing": "border-box"
      }
    },
    "cta": {
      "tag": "button",
      "cls": "cta-button",
      "expectedStyles": {
        "background-color": "rgb(59, 130, 246)",
        "color": "rgb(255, 255, 255)",
        "padding-top": "12px",
        "padding-right": "24px",
        "padding-bottom": "12px",
        "padding-left": "24px",
        "font-size": "16px",
        "border-top-width": "0px",
        "border-right-width": "0px",
        "border-bottom-width": "0px",
        "border-left-width": "0px",
        "border-top-style": "none",
        "border-right-style": "none",
        "border-bottom-style": "none",
        "border-left-style": "none",
        "cursor": "pointer"
      },
      "expectedStates": {
        "hover": {
          "background-color": "rgb(37, 99, 235)"
        },
        "focus": {
          "outline-style": "solid",
          "outline-color": "rgb(59, 130, 246)",
          "outline-width": "2px",
          "outline-offset": "2px"
        },
        "active": {
          "background-color": "rgb(29, 78, 216)"
        }
      }
    },
    "label": {
      "tag": "span",
      "cls": "label-span",
      "expectedStyles": {
        "color": "rgb(71, 85, 105)",
        "font-size": "14px",
        "margin-left": "8px",
        "box-sizing": "border-box"
      }
    },
    "email": {
      "tag": "input",
      "cls": "text-input",
      "expectedStyles": {
        "border-top-style": "solid",
        "border-right-style": "solid",
        "border-bottom-style": "solid",
        "border-left-style": "solid",
        "border-top-color": "rgb(203, 213, 225)",
        "border-right-color": "rgb(203, 213, 225)",
        "border-bottom-color": "rgb(203, 213, 225)",
        "border-left-color": "rgb(203, 213, 225)",
        "padding-top": "8px",
        "padding-right": "12px",
        "padding-bottom": "8px",
        "padding-left": "12px"
      },
      "expectedStates": {
        "focus": {
          "border-top-color": "rgb(59, 130, 246)",
          "border-right-color": "rgb(59, 130, 246)",
          "border-bottom-color": "rgb(59, 130, 246)",
          "border-left-color": "rgb(59, 130, 246)",
          "outline-style": "solid",
          "outline-color": "rgb(191, 219, 254)"
        }
      }
    },
    "badge": {
      "tag": "span",
      "cls": "badge",
      "expectedStyles": {
        "display": "inline-block",
        "position": "relative",
        "padding-left": "20px",
        "color": "rgb(34, 197, 94)"
      },
      "expectedPseudo": {
        "::before": {
          "content": "\"✓\"",
          "position": "absolute",
          "left": "0px",
          "top": "0px",
          "color": "rgb(34, 197, 94)"
        }
      }
    },
    "quote": {
      "tag": "blockquote",
      "cls": "quote",
      "expectedStyles": {
        "position": "relative",
        "padding-left": "24px",
        "padding-right": "24px",
        "font-style": "italic",
        "color": "rgb(100, 116, 139)"
      },
      "expectedPseudo": {
        "::before": {
          "content": "\"\u201c\"",
          "position": "absolute",
          "left": "0px",
          "top": "0px",
          "font-size": "32px",
          "color": "rgb(203, 213, 225)"
        },
        "::after": {
          "content": "\"\u201d\"",
          "position": "absolute",
          "right": "0px",
          "bottom": "0px",
          "font-size": "32px",
          "color": "rgb(203, 213, 225)"
        }
      }
    },
    "flex-layout": {
      "tag": "div",
      "cls": "flex-layout",
      "expectedStyles": {
        "display": "flex",
        "flex-direction": "row-reverse",
        "justify-content": "space-between",
        "align-items": "center",
        "column-gap": "12px",
        "row-gap": "12px"
      }
    },
    "grid-layout": {
      "tag": "div",
      "cls": "grid-layout",
      "expectedStyles": {
        "display": "grid",
        "grid-template-columns": "120px 240px",
        "column-gap": "16px",
        "row-gap": "8px"
      }
    },
    "visual-box": {
      "tag": "div",
      "cls": "visual-box",
      "expectedStyles": {
        "border-top-left-radius": "14px",
        "border-top-right-radius": "6px",
        "border-bottom-right-radius": "10px",
        "border-bottom-left-radius": "4px",
        "box-shadow": "rgb(15, 23, 42) 0px 4px 12px 0px"
      }
    },
    "transform-box": {
      "tag": "div",
      "cls": "transform-box",
      "expectedStyles": {
        "transform": "matrix(1, 0, 0, 1, 12, 8)",
        "opacity": "0.65"
      }
    },
    "focus-visible-control": {
      "tag": "button",
      "cls": "focus-visible-control",
      "expectedStyles": {
        "background-color": "rgb(248, 250, 252)"
      },
      "expectedStates": {
        "focus": {
          "outline-style": "solid",
          "outline-color": "rgb(37, 99, 235)",
          "outline-width": "4px",
          "outline-offset": "2px",
          "box-shadow": "rgb(22, 163, 74) 0px 0px 0px 4px"
        }
      }
    }
  },
  "customProperties": {
    "--primary-color": "rgb(59, 130, 246)"
  }
}
