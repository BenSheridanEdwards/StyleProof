{
  "name": "styleproof",
  "version": "9.0.0",
  "description": "Catch every CSS change before it ships — review PRs and certify refactors by the browser's computed styles, not pixels. Works with any styling system.",
  "keywords": [
    "playwright",
    "css",
    "refactoring",
    "visual-regression",
    "computed-style",
    "computed-styles",
    "tailwind",
    "migration",
    "snapshot",
    "testing",
    "ci"
  ],
  "license": "MIT",
  "author": "Ben Sheridan-Edwards",
  "homepage": "https://github.com/BenSheridanEdwards/StyleProof#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BenSheridanEdwards/StyleProof.git"
  },
  "bugs": {
    "url": "https://github.com/BenSheridanEdwards/StyleProof/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "styleproof": "./bin/styleproof.mjs",
    "styleproof-init": "./bin/styleproof-init.mjs",
    "styleproof-map": "./bin/styleproof-map.mjs",
    "styleproof-capture": "./bin/styleproof-capture.mjs",
    "styleproof-diff": "./bin/styleproof-diff.mjs",
    "styleproof-report": "./bin/styleproof-report.mjs",
    "styleproof-components": "./bin/styleproof-components.mjs",
    "styleproof-variants": "./bin/styleproof-variants.mjs",
    "styleproof-affected": "./bin/styleproof-affected.mjs",
    "styleproof-ci": "./bin/styleproof-ci.mjs",
    "styleproof-publish-report": "./bin/styleproof-publish-report.mjs",
    "styleproof-prune-reports": "./bin/styleproof-prune-reports.mjs",
    "styleproof-prune-maps": "./bin/styleproof-prune-maps.mjs"
  },
  "files": [
    "dist",
    "bin",
    "example/styleproof-approve.yml",
    "example/lint-map-artifacts.yml",
    "docs/demo-composite.png",
    "docs/component-manifest.md",
    "docs/product-state-comparability.md",
    "docs/forced-state-capture.md",
    "docs/setup.md",
    "docs/REFERENCE.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.7.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:slop": "oxlint --quiet",
    "lint:declarative": "eslint -c eslint.declarative.config.js .",
    "format": "prettier --write \"{src,bin,test,example,scripts}/**/*.{ts,mjs,js}\" \"*.{ts,js,mjs,json,md}\"",
    "format:check": "prettier --check \"{src,bin,test,example,scripts}/**/*.{ts,mjs,js}\" \"*.{ts,js,mjs,json,md}\"",
    "privacy:check": "node scripts/privacy-check.mjs",
    "check:anti-slop-vendor": "node scripts/check-anti-slop-vendor.mjs",
    "check:context": "node scripts/check-context-layer.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "verify": "pnpm run check:context && pnpm run check:suppressions && pnpm run typecheck && pnpm run lint && pnpm run lint:slop && pnpm run format:check && pnpm run privacy:check && pnpm test",
    "test": "pnpm run build && node scripts/run-node-test.mjs",
    "test:unit": "node scripts/run-node-test.mjs",
    "test:coverage": "node scripts/check-coverage.mjs",
    "test:watch": "node scripts/run-node-test.mjs --watch",
    "test:e2e": "pnpm run build && playwright test",
    "bench": "pnpm run build && node bench/gate-speed.mjs",
    "demo:report": "pnpm run build && node scripts/demo-report.mjs",
    "demo:check": "pnpm run build && node scripts/demo-report.mjs --check",
    "init": "node ./bin/styleproof-init.mjs",
    "prepare": "pnpm run build && node .husky/install.mjs",
    "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run privacy:check && pnpm test && pnpm run test:e2e",
    "bench:detection": "pnpm run build && node bench/detection-rate.mjs",
    "bench:detection:check": "pnpm run build && node bench/detection-rate.mjs --check",
    "bench:reach": "pnpm run build && node bench/reach-corpus.mjs",
    "bench:reach:check": "pnpm run build && node bench/reach-corpus.mjs --check",
    "bench:reach-cost": "pnpm run build && node bench/reach-cost.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "fallow": "3.34.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.2",
    "oxlint": "1.89.0",
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
