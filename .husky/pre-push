#!/usr/bin/env sh
set -e

echo "› unit tests"
# Git hook env leaks into the temp repos used by CLI tests.
unset $(git rev-parse --local-env-vars)
npm test

echo "› browser e2e (shared path policy)"
# Use the shared CI path policy for staged and pushed files. Unknown first-push
# ranges require the full browser suite; missing Chromium or unreadable inputs
# fail the push instead of silently skipping browser verification.
node scripts/pre-push-e2e.mjs
