{
  "fixture": "bench/detection-fixture.html",
  "expectations": {
    "detect": "a finding must land on the target element (and carry an expected prop when `props` is set)",
    "clean": "zero findings — the change resolves to identical computed styles",
    "blind": "documented detection boundary — zero findings expected on the target"
  },
  "cases": [
    {
      "id": "color-cta-bg",
      "category": "color",
      "expect": "detect",
      "sel": ".sp-cta",
      "props": ["background-color"],
      "css": ".sp-cta { background: #dc2626; }",
      "desc": "CTA background blue→red"
    },
    {
      "id": "color-title-text",
      "category": "color",
      "expect": "detect",
      "sel": ".sp-title",
      "props": ["color"],
      "css": ".sp-title { color: #9f1239; }",
      "desc": "title text colour change"
    },
    {
      "id": "color-card-border",
      "category": "color",
      "expect": "detect",
      "sel": ".sp-card",
      "props": ["border"],
      "css": ".sp-card { border-color: #f59e0b; }",
      "desc": "card border colour"
    },
    {
      "id": "color-nav-bg",
      "category": "color",
      "expect": "detect",
      "sel": ".sp-nav",
      "props": ["background-color"],
