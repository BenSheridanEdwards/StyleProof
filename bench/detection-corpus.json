      "desc": "@keyframes internals rewritten — animation-name unchanged, bodies are not computed styles"
    },
    {
      "id": "blind-img-src",
      "category": "blind",
      "expect": "blind",
      "sel": ".sp-img",
      "attr": [
        ".sp-img",
        "src",
        "data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI2NCIgaGVpZ2h0PSI2NCI+PHJlY3Qgd2lkdGg9IjY0IiBoZWlnaHQ9IjY0IiBmaWxsPSIjZGMyNjI2Ii8+PC9zdmc+"
      ],
      "desc": "img src swapped blue→red — element attributes are not computed styles"
    },
    {
      "id": "blind-aria-label",
      "category": "blind",
      "expect": "blind",
      "sel": ".sp-cta",
      "attr": [".sp-cta", "aria-label", "Start now"],
      "desc": "aria-label added — accessibility metadata is outside style evidence"
    },
    {
      "id": "dom-link-href",
      "category": "dom",
      "expect": "detect",
      "sel": ".sp-ext",
      "attr": [".sp-ext", "href", "#other"],
      "desc": "link href change — href is in the anchor element fingerprint, so the element re-keys as removed+added"
    },
    {
      "id": "text-title",
      "category": "dom",
      "expect": "detect",
      "sel": ".sp-title",
      "text": [".sp-title", "Ship fearless teams"],
      "desc": "title copy change — advisory text layer, captured when captureText is on",
      "captureText": true
    }
