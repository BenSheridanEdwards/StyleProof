    },
    {
      "id": "clean-hex-vs-name",
      "category": "no-op",
      "expect": "clean",
      "css": ".sp-logo { color: #ffffff; }",
      "desc": "white → #ffffff equivalent"
    },
    {
      "id": "clean-margin-longhand",
      "category": "no-op",
      "expect": "clean",
      "css": ".sp-cardtext { margin: 0 0 0 0; }",
