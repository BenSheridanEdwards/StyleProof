  "scope": {
    "kind": "full",
    "issue": 447,
    "full447": true,
    "included": [
      "resting computed-style changes across color, typography, spacing, borders, effects, layout, and CSS variables",
      "pseudo-element computed-style changes",
      "forced-state and cross-element state divergence (#438)",
      "sibling-insertion structure change",
      "rendered change with no computed-style correspondence (expected miss)",
      "no-op controls including a computed-but-not-rendered change"
    ],
    "excluded": [
      "whole-application state coverage",
      "unsupported sensor classes (pixels, network, fonts, canvas rasterisation)",
      "class-wide recall beyond this named frozen corpus",
      "non-Chromium browser engines and non-macOS runners"
    ]
  },
  "expectations": {
    "status": "frozen-pre-run",
    "reviewBasis": "issue #447 acceptance contract; fixture mutation rationale grounded in CSS semantics, not observed detector output",
    "expectedCardinality": 23
  },
  "cases": [
    {
      "id": "computed-rest-background-v2",
      "class": "computed-style",
      "description": "A resting background color changes on the same element.",
      "body": "<main><div class=\"box\">Resting box</div></main>",
      "beforeCss": ".box{display:block;width:180px;height:72px;background-color:rgb(200,200,200)}",
      "afterCss": ".box{display:block;width:180px;height:72px;background-color:rgb(80,120,200)}",
      "proof": {
        "selector": ".box",
        "property": "backgroundColor",
        "before": "rgb(200, 200, 200)",
        "after": "rgb(80, 120, 200)"
      },
      "expected": {
        "renderChanged": true,
        "detected": true,
        "findingKind": "style",
        "findingProperty": "background-color"
      }
    },
    {
